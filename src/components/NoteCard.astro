---
interface Props {
  slug: string;
  title: string;
  summary?: string;
  stage: "graine" | "pousse" | "arbre";
  tags: string[];
}

const { slug, title, summary, stage, tags } = Astro.props;
---

<li class="card">
  <span class:list={["stage", `stage-${stage}`]}>
    <span class="stage-dot"></span>
    {stage}
  </span>
  <h3><a href={`/notes/${slug}/`}>{title}</a></h3>
  {summary && <p>{summary}</p>}
  {
    tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )
  }
</li>
